 "hooks": {
  "a": {
   "label": "Situation",
   "audio": "Dein Kind mag plötzlich nicht mehr in die Schule, obwohl sich dort fast nichts geändert hat.",
   "card": [
    "Sie mag nicht mehr in die Schule.",
    "Dabei ist fast alles gleich."
   ]
  },
  "b": {
   "label": "Umdeutung",
   "audio": "Salz schmeckt man erst, wenn es fehlt, und bei Kindern ist das genauso.",
   "card": [
    "Salz schmeckt man erst,",
    "wenn es fehlt."
   ]
  },
  "c": {
   "label": "Zitat/Zahl",
   "audio": "„Die schmeckt nach nichts“, sagt Marie, und dabei fehlt nur eine Prise.",
   "card": [
    "„Die schmeckt nach nichts.“",
    "Dabei fehlt nur eine Prise."
   ]
  }
 },
 "script": {
  "lockin": "Papa kocht Kartoffelsuppe. Marie ist acht. Sie kostet und verzieht das Gesicht: „Die schmeckt nach nichts.“ Dabei ist alles drin: Kartoffeln, Karotten, Lauch. Nur das Salz fehlt. Papa salzt nach.",
  "block1": "Salz schmeckt man erst, wenn es fehlt. Noch nie hat jemand gesagt: „Mmh, schön salzig.“ Schau dir das als Schrank an. Oben die Suppe, darunter Kartoffeln, Karotten, Lauch. Ganz unten das Salz. Man sieht es nicht, aber es trägt jeden Geschmack darüber.",
  "rehook1": "Bei Marie fehlt diese Woche noch ein zweites Salz.",
  "block2": "Ihre Lehrerin ist zwei Wochen weg. „Ich mag nicht mehr in die Schule“, sagt Marie. Papa sucht oben: Ist Mathe zu schwer? Gibt es Streit? Aber oben ist alles wie immer. Was fehlt, liegt ganz unten: das Gefühl, dass sie dort jemand kennt.",
  "rehook2": "Und auch das kann man nachsalzen.",
  "block3": "Am nächsten Morgen sagt Papa zur neuen Lehrerin: „Das ist Marie. Sie liest gern vor.“ Am Abend strahlt Marie: „Ich durfte vorlesen!“ Was unten fehlt, schmeckt man oben überall. Und oft reicht eine Prise.",
  "closing": "Was ist bei euch das Salz, das man erst merkt, wenn es fehlt?",
  "cta": "Mehr solche Lerngeschichten gibt es in meiner WhatsApp-Gruppe Entdeckerfreunde: Schreib mir „Entdecker“, dann schick ich dir den Link."
 },
