 "hooks": {
  "a": {
   "label": "Situation",
   "audio": "Deine Freundin schwärmt von deinem Curry, und du denkst nur: Ist der Reis zu weich?",
   "card": [
    "Sie schwärmt vom Curry,",
    "*du denkst an den Reis*"
   ]
  },
  "b": {
   "label": "Umdeutung",
   "audio": "Für dich ist es ein Gericht, für ihn ist es eine Zutatenliste.",
   "card": [
    "Für dich ein Gericht.",
    "*Für ihn eine Zutatenliste.*"
   ]
  },
  "c": {
   "label": "Zitat/Zahl",
   "audio": "„Sind da Nüsse drin?“: Für diese Frage muss man ganz nach unten.",
   "card": [
    "„Sind da Nüsse drin?“",
    "*Dafür geht's ganz nach unten*"
   ]
  }
 },
 "script": {
  "lockin": "Jana ist vierzig und kocht für zwei Freunde Kürbiscurry. Nina kostet und strahlt: „Wie im Urlaub!“ Jana denkt nur: „Ist der Reis zu weich?“ Und David fragt: „Sind da Nüsse drin?“",
  "block1": "Schau dir das als Knoten an. Oben steht das Gericht: Kürbiscurry. Dort ist Nina. Darunter Sauce, Reis und Garzeit. Dort ist Jana. Ganz unten die Zutaten. Dort sucht David. Wer hat recht? Alle drei. Es gibt keine richtige Ebene, nur die passende für den Moment.",
  "rehook1": "Für David liegt sie heute ganz unten.",
  "block2": "David verträgt keine Nüsse. „Schmeckt gut“ hilft ihm nicht. Jana geht mit ihm die Zutaten durch: Kürbis, Kokosmilch, Ingwer. Und darüber gestreut: Cashews! Sie macht ihm einen Teller ohne. Jetzt darf auch David nach oben: „Wie im Urlaub!“",
  "rehook2": "Nur Jana hängt noch beim Reis fest.",
  "block3": "Nina lacht: „Der Reis ist perfekt. Iss mit!“ Jana kostet. Zum ersten Mal an diesem Abend schmeckt sie das Curry. Geht etwas schief, geh nach unten. Passt alles, darfst du wieder hinauf.",
  "closing": "Auf welcher Ebene hängst du fest, obwohl gerade alles passt?",
  "cta": "Genau darum geht es in meinem Zwei-Stunden-Kurs zu vertikalem Wissen. Schreib mir eine DM."
 },
