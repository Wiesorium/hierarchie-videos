 "hooks": {
  "c": {
   "label": "Du-Fehler",
   "audio": "Du sagst „gleich“. Dein Kind hört: nie.",
   "card": [
    "Nicht ungeduldig.",
    "*Ihm fehlt eine Schublade.*"
   ]
  }
 },
 "script": {
  "lockin": "Darum fragt es alle zwei Minuten nach. Was stattdessen hilft, siehst du gleich. Noah ist fünf. Nach dem Abendessen fragt er: „Papa, bauen wir eine Höhle?“ Papa wäscht gerade ab und sagt, was wir alle sagen: „Gleich.“",
  "block1": "Schau dir das Wort als Schrank an. Oben liegt: gleich. Bei dir hängt darunter eine Schublade: zehn Minuten. Du siehst sie gar nicht mehr. Bei Noah hängt darunter nichts. Er kann noch keine Uhr lesen.",
  "rehook1": "Und genau hier machen es die meisten falsch.",
  "block2": "Wir erklären es genauer: „In zehn Minuten!“ Aber für Noah sind Minuten nur ein neues Wort. Auch darunter hängt nichts. Also fragt er weiter: „Jetzt?“ Das ist kein Quengeln. Das Fragen ist seine einzige Uhr.",
  "rehook2": "So. Jetzt der wichtige Teil.",
  "block3": "Häng dein Gleich an ein Ding, das dein Kind sehen kann. Papa sagt: „Wenn die drei Teller sauber sind, bauen wir die Höhle.“ Noah zählt mit: „Noch zwei!“ „Noch einer!“ Und fragt kein einziges Mal. Für Tage machst du das längst: „Noch zweimal schlafen.“ Für Minuten geht es genauso.",
  "closing": "Woran hängst du heute dein nächstes „gleich“?",
  "cta": "Folg mir, wenn du heute auch schon „gleich“ gesagt hast."
 },
 "question": [
  "Woran hängst du heute",
  "dein nächstes „gleich“?"
 ],
 "endcard": {
  "title": "Folg mir",
  "pill": "hierarchologie",
  "lines": [
   "wenn du heute auch schon",
   "„gleich“ gesagt hast"
  ],
  "button": "Folgen"
 },
