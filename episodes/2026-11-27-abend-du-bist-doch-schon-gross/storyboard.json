 "hooks": {
  "c": {
   "label": "Du-Fehler",
   "audio": "„Du bist doch schon groß!“ hilft selten.",
   "card": [
    "Groß – aber",
    "*wofür?*"
   ]
  }
 },
 "script": {
  "lockin": "Ich weiß, das sag ich auch. Was besser hilft, zeig ich dir am Ende. Finn ist fünf. Er soll den Pyjama allein anziehen. „Das kann ich nicht.“ Papa sagt: „Du bist doch schon groß!“ Und Finn ruft: „Nein! Ich bin klein!“ Dabei wollte er eben noch länger aufbleiben. Weil er groß ist.",
  "block1": "Schau dir das als Knoten an. „Groß“ steht ganz oben. Darunter hängen viele kleine Schubladen: Zähne putzen. Knöpfe zumachen. Lange aufbleiben. Und jede wächst für sich. Bei Finn sind manche schon voll. Andere noch leer.",
  "rehook1": "Aber genau da liegt das Problem.",
  "block2": "„Du bist doch groß“ redet nur mit der obersten Schublade. Finn hört vielleicht: Wer groß ist, kann alles. Aber die Knöpfe kann er nicht. Also ist er wohl ganz klein. Und der Streit bleibt oben hängen.",
  "rehook2": "So. Jetzt der wichtige Teil.",
  "block3": "Frag eine Schublade tiefer: „Wofür bist du schon groß?“ Finn schnieft. „Zähne putzen.“ „Und wofür noch nicht?“ „Knöpfe.“ „Dann machen wir die zusammen.“ Den untersten Knopf schafft Finn allein. Und Papa sagt: „Bei dem Knopf bist du jetzt groß.“ Finn grinst.",
  "closing": "Was sagst du nächstes Mal statt „Du bist doch groß“?",
  "cta": "Folg mir, wenn du auch schon „Du bist doch groß!“ gesagt hast."
 },
 "question": [
  "Was sagst du nächstes Mal",
  "statt „Du bist doch groß“?"
 ],
 "endcard": {
  "title": "Folg mir",
  "pill": "hierarchologie",
  "lines": [
   "wenn du auch schon",
   "„Du bist doch groß!“ gesagt hast"
  ],
  "button": "Folgen"
 },
