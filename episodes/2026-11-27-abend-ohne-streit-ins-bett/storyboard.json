 "hooks": {
  "b": {
   "label": "Ergebnis zuerst",
   "audio": "Finn geht ohne Streit ins Bett.",
   "card": [
    "Papa hat nur",
    "*anders gefragt.*"
   ]
  }
 },
 "script": {
  "lockin": "Dabei wollte er eben noch länger aufbleiben. Finn ist fünf. „Ich bin schon groß!“, hat er gerufen. Papa sagte: „Dann zieh dir den Pyjama allein an.“ Und Finn: „Das kann ich nicht. Dafür bin ich noch zu klein.“ Merk dir diesen Satz. Der wird gleich wichtig.",
  "block1": "Schau dir das als Knoten an. Ganz oben steht „groß“. Darunter hängen viele kleine Schubladen: Zähne putzen. Knöpfe zumachen. Lange aufbleiben. Und jede wächst für sich. Finn ist also nicht groß oder klein. Er ist beides. Gleichzeitig.",
  "rehook1": "Ich zeig dir, wie das konkret aussieht.",
  "block2": "Papa streitet nicht oben über „groß“. Er fragt eine Schublade tiefer: „Wofür bist du schon groß?“ Finn strahlt: „Zähne putzen! Ganz allein!“ „Und wofür noch nicht?“ Finn zeigt auf den Pyjama: „Knöpfe.“ Also machen sie die Knöpfe zusammen. Den untersten schafft Finn allein.",
  "rehook2": "Ich nenne das die Wofür-Frage.",
  "block3": "Nicht „Bist du groß?“, sondern „Wofür?“. Dann fragt Papa: „Und fürs Aufbleiben?“ Finn gähnt. Und jetzt kommt der Satz von vorhin: „Dafür bin ich heute noch klein.“ Kein Streit. Finn hat es selbst einsortiert.",
  "closing": "Und wofür bist du selbst noch klein?",
  "cta": "Folg mir, damit Kinder Schublade für Schublade groß werden dürfen."
 },
 "question": [
  "Und wofür bist du",
  "selbst noch klein?"
 ],
 "endcard": {
  "title": "Folg mir",
  "pill": "hierarchologie",
  "lines": [
   "damit Kinder Schublade",
   "für Schublade groß werden"
  ],
  "button": "Folgen"
 },
