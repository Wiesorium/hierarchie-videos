 "hooks": {
  "a": {
   "label": "Situation",
   "audio": "Du hast neun Planeten gelernt, dein Kind nur acht.",
   "card": [
    "Du hast 9 Planeten gelernt,",
    "dein Kind nur 8"
   ]
  },
  "b": {
   "label": "Umdeutung",
   "audio": "Pluto hat sich nicht verändert, nur seine Schublade.",
   "card": [
    "Pluto hat sich nicht verändert.",
    "Nur seine Schublade"
   ]
  },
  "c": {
   "label": "Zahl",
   "audio": "Seit zwanzig Jahren ist Pluto kein Planet mehr, und er hat nichts davon gemerkt.",
   "card": [
    "Seit 20 Jahren kein Planet",
    "und Pluto merkt nichts"
   ]
  }
 },
 "script": {
  "lockin": "Ella ist neun. Sie blättert in Papas altem Sternenbuch und zählt die Planeten. Neun! In der Schule hat sie nur acht gelernt. Leise fragt sie: „Papa, haben sie Pluto rausgeworfen?“",
  "block1": "Schau dir das als Schrank an. Unten liegen Erde, Mars, Jupiter und Pluto. Oben gab es früher nur eine Schublade: „Planet“. Pluto selbst hat sich nie verändert. Er ist so klein, so kalt und so weit weg wie immer. Geändert hat sich die Schublade darüber. Heute gibt es zwei: „Planet“ und „Zwergplanet“.",
  "rehook1": "Aber warum haben Sternforscher die Schublade umgebaut?",
  "block2": "Papa erklärt: Weit draußen fanden sie immer mehr Eisbrocken. Einer war fast so groß wie Pluto. Also schrieben sie genauer auf, was ein Planet ist: Er räumt seine Bahn um die Sonne frei, wie ein Schneepflug. Pluto kreist mitten zwischen den Eisbrocken. Darum bekam er vor zwanzig Jahren die neue Schublade.",
  "rehook2": "Und dann hat Ella eine Idee.",
  "block3": "Sie klebt einen Zettel in Papas Buch, gleich neben Pluto: „Zwergplanet“. Ella strahlt: „Dann ist Pluto ja gar nicht weg!“ Papa lacht: „Und mein Buch stimmt wieder.“ Papa hat nicht falsch gelernt. Manchmal heißt Lernen nicht dazulernen, sondern umsortieren.",
  "closing": "Was hast du als Kind gelernt, das heute in einer neuen Schublade liegt?",
  "cta": "Mehr solche Lerngeschichten gibt es in meiner WhatsApp-Gruppe Entdeckerfreunde: Schreib mir „Entdecker“, dann schick ich dir den Link."
 },
 "question": [
  "Was hast du als Kind gelernt,",
  "das heute in einer neuen Schublade liegt?"
 ],
