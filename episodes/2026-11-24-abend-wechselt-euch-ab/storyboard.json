  "c": {
   "label": "Du-Fehler",
   "audio": "„Wechselt euch ab!“ macht beide unglücklich.",
   "card": [
    "Gerecht.",
    "*Aber eine Schublade zu tief.*"
   ]
  }
 },
 "script": {
  "lockin": "Ich weiß, es klingt fair. Bleib bis zum Schluss, da kommt die Frage, die beide glücklich macht. Greta ist acht, Luis ist fünf. Im Garten ziehen beide am selben Ball. „Meiner!“ „Nein, meiner!“ Und Mama sagt, was wir alle sagen: „Wechselt euch ab!“",
  "block1": "Schau dir den Streit als Schrank an. Ganz unten liegt ein Ding: der Ball. Abwechseln teilt dieses Ding gerecht auf. Aber es bleibt ganz unten. Und unten kann immer nur einer den Ball haben.",
  "rehook1": "Hier hören die meisten auf. Genau das ist der Fehler.",
  "block2": "Luis bekommt den Ball zuerst. Er kickt ihn einmal. Dann schaut er zu Greta: „Spielst du mit?“ Ein ganzer Ball für ihn allein, und er ist trotzdem traurig. Luis wollte gar nicht den Ball. Er wollte seine Schwester.",
  "rehook2": "Ich zeig dir, wie das konkret aussieht.",
  "block3": "Frag eine Schublade höher: „Wofür brauchst du den Ball?“ Greta: „Ich will Elfmeter üben.“ Luis: „Ich will mit Greta spielen.“ Wer Elfmeter übt, braucht einen im Tor. Zwei Rucksäcke, Luis dazwischen. Greta schießt, Luis hält. Unten gibt es nur einen Ball. Oben ist Platz für zwei.",
  "closing": "Wofür streiten deine Kinder wirklich?",
  "cta": "Folg mir, wenn du auch schon hundertmal „Wechselt euch ab“ gesagt hast."
 },
 "question": [
  "Wofür streiten deine",
  "Kinder wirklich?"
 ],
 "endcard": {
  "title": "Folg mir",
  "pill": "hierarchologie",
  "lines": [
   "wenn du auch schon hundertmal",
   "„Wechselt euch ab“ gesagt hast"
  ],
  "button": "Folgen"
 },
