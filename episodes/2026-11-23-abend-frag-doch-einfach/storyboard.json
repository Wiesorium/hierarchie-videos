 "hooks": {
  "c": {
   "label": "Du-Fehler",
   "audio": "„Frag doch einfach!“ hilft deinem Kind nicht.",
   "card": [
    "Klingt leicht.",
    "*Ist es nicht.*"
   ]
  }
 },
 "script": {
  "lockin": "Weil es seine Frage noch gar nicht kennt. Was stattdessen hilft, siehst du gleich. Lena ist neun. Nach der Schule sagt sie: „Ich versteh Mathe nicht.“ Papa sagt, was wir alle sagen: „Dann frag morgen einfach die Lehrerin!“ Lena schüttelt den Kopf.",
  "block1": "Schau dir ihre Frage als Schrank an. „Ich versteh Mathe nicht“ hängt ganz oben. Das klingt, als wäre alles leer. Wer sagt so etwas gern vor der ganzen Klasse? Darunter liegen die echten Schubladen: die Einer. Die Zehner. Die kleine Eins, die man sich merkt. Fast alle sind voll.",
  "rehook1": "Und hier hören die meisten auf. Genau das ist der Fehler.",
  "block2": "„Frag doch einfach“ schickt dein Kind mit der großen Frage los. Die kleine, die es sich trauen würde, liegt eine Schublade tiefer. Und die sucht man am besten zu zweit.",
  "rehook2": "So. Jetzt der wichtige Teil.",
  "block3": "Papa fragt nach unten: „Kannst du die Einer?“ „Ja.“ „Die Zehner?“ „Ja.“ „Und die kleine Eins?“ „Nein. Woher kommt die?“ Da ist sie, die echte Frage. Klein genug für morgen. Am nächsten Tag zeigt Lena auf. Und drei Kinder nicken.",
  "closing": "Welche kleine Frage sucht ihr heute zusammen?",
  "cta": "Folg mir, wenn du auch schon „Frag doch einfach“ gesagt hast."
 },
 "question": [
  "Welche kleine Frage",
  "sucht ihr heute zusammen?"
 ],
 "endcard": {
  "title": "Folg mir",
  "pill": "hierarchologie",
  "lines": [
   "wenn du auch schon",
   "„Frag doch einfach“ gesagt hast"
  ],
  "button": "Folgen"
 },
